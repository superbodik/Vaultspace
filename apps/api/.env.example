# Local dev: started by `npm run db:up` (embedded Postgres-compatible PGlite server, no Docker needed)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dataroom"
PGLITE_PORT=55432

# In production, point this to a real managed Postgres (Neon, Supabase, RDS, Render...)

PORT=4000
NODE_ENV=development

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS="http://localhost:5173"

# "local" stores uploaded files on disk under apps/api/uploads.
# "s3" streams them to any S3-compatible bucket (AWS S3, Supabase Storage, Cloudflare R2, MinIO...).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./uploads"

S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Public base URL of this API, used to build absolute file view/download links
API_PUBLIC_URL="http://localhost:4000"
# Public base URL of the web app, used to build share links
WEB_PUBLIC_URL="http://localhost:5173"
