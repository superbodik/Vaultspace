# Overrides for `docker compose up` (copy to .env in this same directory —
# Compose loads it automatically). Everything has a working default for
# running purely on localhost; you only need this file to change ports/domains
# or to set a real JWT_SECRET before exposing the app beyond your own machine.
#
# For local dev *without* Docker, see apps/api/.env.example and apps/web/.env.example instead.

JWT_SECRET=change-me-to-a-long-random-string

# Host ports docker-compose publishes the containers on.
API_PORT=4000
WEB_PORT=5173

# Public URLs the containers should think they're reachable at. Update these
# once you put the app behind a real domain / tunnel (e.g. Cloudflare Tunnel) —
# VITE_API_URL in particular is baked into the frontend build, so the web
# image must be rebuilt (`docker compose build web`) after changing it.
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Seeds demo@acme.test / password123 with a sample data room on first boot.
SEED_ON_BOOT=true
